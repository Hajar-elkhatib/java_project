<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<footer class="bg-netflix-black border-t border-white/10 pt-16 pb-12 px-4 md:px-12 mt-auto">
    <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
            <div class="space-y-4">
                <h4 class="text-white font-bold text-sm uppercase tracking-widest">Navigation</h4>
                <ul class="text-gray-500 text-sm space-y-2">
                    <li><a href="${pageContext.request.contextPath}/" class="hover:underline">Accueil</a></li>
                    <li><a href="${pageContext.request.contextPath}/movies" class="hover:underline">Tous les Films</a></li>
                    <li><a href="${pageContext.request.contextPath}/series" class="hover:underline">Séries TV</a></li>
                    <li><a href="${pageContext.request.contextPath}/documentaries" class="hover:underline">Documentaires</a></li>
                </ul>
            </div>
            <div class="space-y-4">
                <h4 class="text-white font-bold text-sm uppercase tracking-widest">Compte</h4>
                <ul class="text-gray-500 text-sm space-y-2">
                    <li><a href="${pageContext.request.contextPath}/profile" class="hover:underline">Mon Profil</a></li>
                    <li><a href="${pageContext.request.contextPath}/login" class="hover:underline">Se Connecter</a></li>
                    <li><a href="${pageContext.request.contextPath}/register" class="hover:underline">S'inscrire</a></li>
                </ul>
            </div>
            <div class="space-y-4">
                <h4 class="text-white font-bold text-sm uppercase tracking-widest">Support</h4>
                <ul class="text-gray-500 text-sm space-y-2">
                    <li><a href="#" class="hover:underline">Centre d'aide</a></li>
                    <li><a href="#" class="hover:underline">Confidentialité</a></li>
                    <li><a href="#" class="hover:underline">Conditions d'utilisation</a></li>
                </ul>
            </div>
            <div class="space-y-6">
                <div class="flex gap-4">
                    <a href="#" class="text-white hover:text-gray-400 text-xl"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-white hover:text-gray-400 text-xl"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-white hover:text-gray-400 text-xl"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-white hover:text-gray-400 text-xl"><i class="bi bi-youtube"></i></a>
                </div>
                <!-- Mini Logo -->
                <div class="text-netflix-red font-black text-xl tracking-tighter uppercase opacity-30">
                    CineStream
                </div>
            </div>
        </div>
        
        <div class="border-t border-white/5 pt-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4 text-gray-600 text-[10px] sm:text-xs">
            <p>&copy; 2026 CineStream Inc. Tous droits réservés.</p>
            <div class="flex gap-4">
                <span class="px-2 py-0.5 border border-gray-800 rounded">Code: 4522-XP</span>
                <span class="px-2 py-0.5 border border-gray-800 rounded">v2.4.0 (Spring-JSP)</span>
            </div>
        </div>
    </div>
</footer>

<!-- External JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
